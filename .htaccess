<FilesMatch "(?i)^(\.|config.*\.php$|composer\.(json|lock)$|.*\.log$|dev-router\.php$|build-release\.sh$)">
    Require all denied
</FilesMatch>

<If "%{REQUEST_URI} =~ m#(?i)/(\.[^/]*|src|templates|migrations|vendor|bin|releases|tests)(/|$)#">
    Require all denied
</If>

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny direct access to internal directories.
    RewriteRule ^(src|templates|migrations|vendor|bin|releases|tests)(/|$) - [F,L]

    # Requests already targeting public/ pass through (public/.htaccess takes over).
    RewriteRule ^public/ - [L]

    # Map everything else into public/.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
