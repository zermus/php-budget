# php-budget flat-deploy shim.
# Used when the app is extracted directly into a web root. If your document
# root points at public/ instead, this file is never consulted.

# Never serve the config, dependency manifests, or logs (mail.log holds
# reminder emails when the "log" transport is used).
<FilesMatch "^(config(\.sample)?\.php|composer\.(json|lock)|.*\.log)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny direct access to internal directories.
    RewriteRule ^(src|templates|migrations|vendor|bin|releases|tests)(/|$) - [F,L]

    # Requests already targeting public/ pass through (public/.htaccess takes over).
    RewriteRule ^public/ - [L]

    # Map everything else into public/.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite the app won't route anyway, but internals must still
# stay private. The optional prefix covers root and subdirectory installs.
<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 403 ^(/.*)?/(src|templates|migrations|vendor|bin|releases|tests)(/|$)
    </IfModule>
</IfModule>
